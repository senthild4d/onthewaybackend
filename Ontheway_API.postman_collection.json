{
  "info": {
    "name": "RealEstate API - Auth + Properties",
    "_postman_id": "real-estate-api-collection-v1",
    "description": "Real-estate backend API collection\n\n## Roles\nAllowed roles: user, owner\nAdmin is a flag: users.is_admin=true\n\n## Base URL\nSet `{{base_url}}` (example: http://localhost:3000)\n\n## Auth\nMost requests use Bearer token `{{jwt_token}}`.\n\n## Main resources\n- Auth (OTP)\n- Profile\n- Properties (CRUD + media + approval + lifecycle)\n- Favorites\n- Viewings (appointments)\n- Maps (properties only)\n",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Send OTP (phone)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"1234567890\"\n}" },
            "url": { "raw": "{{base_url}}/api/v1/auth/send_otp", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "send_otp"] }
          }
        },
        {
          "name": "Send OTP (email)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\"\n}" },
            "url": { "raw": "{{base_url}}/api/v1/auth/send_otp", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "send_otp"] }
          }
        },
        {
          "name": "Verify OTP (phone)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"1234567890\",\n  \"code\": \"123456\"\n}" },
            "url": { "raw": "{{base_url}}/api/v1/auth/verify_otp", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "verify_otp"] }
          }
        },
        {
          "name": "Verify OTP (email)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"code\": \"123456\"\n}" },
            "url": { "raw": "{{base_url}}/api/v1/auth/verify_otp", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "verify_otp"] }
          }
        },
        {
          "name": "Complete Registration (user)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"verification_token\": \"{{verification_token}}\",\n  \"role\": \"user\",\n  \"name\": \"Test User\",\n  \"email\": \"user@example.com\",\n  \"phone\": \"1234567890\",\n  \"description\": \"Looking for a new home\",\n  \"address\": \"123 Main Street, City\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/auth/complete_registration", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "complete_registration"] }
          }
        },
        {
          "name": "Complete Registration (owner)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"verification_token\": \"{{verification_token}}\",\n  \"role\": \"owner\",\n  \"name\": \"Property Owner\",\n  \"email\": \"owner@realestate.com\",\n  \"phone\": \"9876543210\",\n  \"description\": \"Licensed real estate agent with 10 years of experience\",\n  \"address\": \"456 Business Tower, Dubai, UAE\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/auth/complete_registration", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "complete_registration"] }
          }
        },

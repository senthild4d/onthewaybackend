# Vibes API - Production Environment Variables Template
# Copy this file to .env.production on your server and fill in your values
# Command: cp env.production.template .env.production

# ===========================================
# Database Configuration
# ===========================================
VIBES_DATABASE_PASSWORD=YOUR_DATABASE_PASSWORD_HERE

# ===========================================
# Rails Configuration
# ===========================================
RAILS_ENV=production
SECRET_KEY_BASE=YOUR_SECRET_KEY_HERE

# Generate SECRET_KEY_BASE with: rails secret
# Keep this secret and never commit it to Git!

# ===========================================
# Server Configuration
# ===========================================
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2

# ===========================================
# Security
# ===========================================
FORCE_SSL=true

# ===========================================
# Email (SendGrid)
# ===========================================
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY
SENDGRID_FROM_EMAIL=no-reply@yourdomain.com
SENDGRID_FROM_NAME=Vibes

# ===========================================
# SMS (Twilio)
# ===========================================
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=+1234567890
# Or use Messaging Service SID instead of phone number
TWILIO_MESSAGING_SERVICE_SID=
